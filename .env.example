# durianrcs / RC-SMS provider (server 1)
DURIAN_BASE=https://vpapi.durianrcs.com/out/ext_api
DURIAN_NAME=your_username
DURIAN_APIKEY=your_api_key

# GrizzlySMS provider (server 2) - sms-activate compatible
GRIZZLY_BASE=https://api.grizzlysms.com/stubs/handler_api.php
GRIZZLY_APIKEY=your_api_key
GRIZZLY_COUNTRY=22

# PhantomUnion provider (server 3) - pickCode-api
PHANTOM_BASE=http://www.phantomunion.com:10023/pickCode-api/push
PHANTOM_KEY=your_api_key
PHANTOM_COUNTRY=IN

# SMSBower provider (server 4) - sms-activate compatible
SMSBOWER_BASE=https://smsbower.online/stubs/handler_api.php
SMSBOWER_APIKEY=your_api_key
SMSBOWER_COUNTRY=22

# mail.tm temp-mail provider (email section) - uses SMSBower mail API for Gmail
MAILTM_BASE=https://api.mail.tm

# backend port
PORT=8787